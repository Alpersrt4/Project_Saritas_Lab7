<Window x:Class="WpfUI.AddDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Task" Height="250" Width="300" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel Background="#f4f4f4">
            <TextBlock Text="Task Title:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Name="TxtTitle" Margin="0,0,0,15"/>

            <TextBlock Text="Estimated Hours:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox Name="TxtHours" Margin="0,0,0,20"/>

            <Button Content="Save Task" Click="BtnSave_Click" Background="#4CAF50" Foreground="White" FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>